# Slack app (HTTP mode — Events API + Interactivity) — see README for how to create these
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Only messages in this channel trigger the bot — right-click the channel in
# Slack -> View channel details -> Channel ID (bottom of the panel).
SLACK_CHANNEL_ID=C0123456789

# Local dev server port (Vercel ignores this — it only applies to `npm run dev`)
PORT=3000

# Redis — holds drafts/pending requests between requests, since serverless functions
# don't share in-memory state. If connected via Vercel's Storage tab, these are
# injected automatically under the legacy KV_* names (a holdover from the deprecated
# @vercel/kv product); for local dev, run `vercel env pull .env.development.local`,
# or copy the REST URL/token from your Upstash database's dashboard directly.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Text generation — pick one provider and fill in only its section below.
# LLM_PROVIDER=openrouter | openai | anthropic | gemini (default: openrouter)
LLM_PROVIDER=openrouter

# openrouter — free key at https://openrouter.ai/keys (no card required)
OPENROUTER_API_KEY=sk-or-...
# Optional: override the default free model — free models rotate, see README
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# openai — key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# anthropic — key from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# gemini — key from https://aistudio.google.com/apikey. NOTE: a Gemini Pro / Google AI Pro
# subscription does NOT include API access; this key is separate and billed on its own
# meter (it does have a free tier). Gemini grounds drafts with Google Search, so posts come
# back with real sources, same as the anthropic path.
# GEMINI_API_KEY=
# Optional — gemini-2.5-pro writes better copy but is slower with a tighter free-tier limit.
# GEMINI_MODEL=gemini-2.5-flash

# Poster images. Generated by OpenAI's image model regardless of LLM_PROVIDER, so posters
# work even when Claude or Gemini writes the text — just the OPENAI_API_KEY from the openai
# section above (uncomment it there even if you're not using openai for text). Defaults to
# on whenever that key is set; set POST_IMAGES=off for text-only posts without removing the
# key. Previewing posters in Slack needs the files:write scope.
# POST_IMAGES=on
# gpt-image-1 is OpenAI's current image model and renders legible text well (the point of
# a poster).
# OPENAI_IMAGE_MODEL=gpt-image-1
# 1:1 fills more of a mobile feed than a 1.91:1 banner, without the crop portrait gets.
# Mapped to the closest of gpt-image-1's fixed sizes (square/landscape/portrait).
# POST_IMAGE_ASPECT_RATIO=1:1

# LinkedIn app — see README, filled in before running scripts/linkedin-auth.ts
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# LinkedIn credentials — filled in automatically by `npm run linkedin-auth`
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

# Optional: change the trigger phrases (case-insensitive substring match)
# TRIGGER_PHRASE=create a post
# CALENDAR_TRIGGER_PHRASE=content calendar
# EDIT_TRIGGER_PHRASE=edit post

# Content calendar scheduling — only needed if you use the "content calendar" command.
# Get these from https://console.upstash.com -> QStash (same account as your Redis database).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional — the @upstash/qstash SDK reads this itself as a fallback API base URL;
# our code never reads it directly. Only needed if Upstash gives you a non-default one.
QSTASH_URL=
# Public base URL QStash calls back on schedule (e.g. https://your-app.vercel.app).
# Optional on Vercel — falls back to https://$VERCEL_URL if unset.
APP_BASE_URL=
